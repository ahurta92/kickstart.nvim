[Unit]
Description=Obsidian Sync (headless, continuous)
After=network-online.target
Wants=network-online.target
# GPFS hiccups and login-node churn: retry, but do not spin forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.config/nvim/scripts/obsidian-sync.sh
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
